  "question_pt": "Qual o custo medio por dia calendario de internacao por especialidade e desfecho de morte?",
  "executed_at": "2026-07-09T00:37:01.892591+00:00",
  "database_file": "/Users/maiconkevyn/PycharmProjects/databases/datasus/sihrd5.duckdb",
  "sql": "SELECT e.\"DESCRICAO\" AS especialidade,\n       CASE WHEN i.\"MORTE\" = true THEN 'obito' ELSE 'sem_obito' END AS desfecho,\n       COUNT(*) AS total_internacoes,\n       ROUND(AVG(i.\"VAL_TOT\" / NULLIF(date_diff('day', i.\"DT_INTER\", i.\"DT_SAIDA\") + 1, 0)), 2) AS custo_medio_por_dia_calendario\nFROM internacoes i\nJOIN especialidade e ON i.\"ESPEC\" = e.\"ESPEC\"\nWHERE i.\"VAL_TOT\" IS NOT NULL\n  AND i.\"DT_INTER\" IS NOT NULL\n  AND i.\"DT_SAIDA\" IS NOT NULL\n  AND date_diff('day', i.\"DT_INTER\", i.\"DT_SAIDA\") >= 0\nGROUP BY e.\"DESCRICAO\", desfecho\nHAVING COUNT(*) > 1000\nORDER BY custo_medio_por_dia_calendario DESC\nLIMIT 20",
