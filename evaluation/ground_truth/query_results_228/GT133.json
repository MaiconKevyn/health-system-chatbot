  "sql": "SELECT ano, mes, total_uti FROM (SELECT EXTRACT(YEAR FROM \"DT_INTER\") AS ano, EXTRACT(MONTH FROM \"DT_INTER\") AS mes, COUNT(*) AS total_uti, ROW_NUMBER() OVER (PARTITION BY EXTRACT(YEAR FROM \"DT_INTER\") ORDER BY COUNT(*) DESC) AS rn FROM internacoes WHERE \"VAL_UTI\" > 0 AND \"DT_INTER\" IS NOT NULL AND EXTRACT(YEAR FROM \"DT_INTER\") BETWEEN 2008 AND 2023 GROUP BY ano, mes) sub WHERE rn = 1 ORDER BY ano",
