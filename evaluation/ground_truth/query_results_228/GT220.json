  "question_pt": "Qual a distribuicao mensal percentual das internacoes respiratorias e nao respiratorias?",
  "executed_at": "2026-07-09T00:37:00.690202+00:00",
  "database_file": "/Users/maiconkevyn/PycharmProjects/databases/datasus/sihrd5.duckdb",
  "sql": "WITH base AS (SELECT EXTRACT(MONTH FROM \"DT_INTER\") AS mes, CASE WHEN \"DIAG_PRINC\" LIKE 'J%' THEN 'respiratoria' ELSE 'nao_respiratoria' END AS grupo, COUNT(*) AS total FROM internacoes WHERE \"DT_INTER\" IS NOT NULL GROUP BY mes, grupo) SELECT mes, grupo, total, ROUND(total * 100.0 / SUM(total) OVER (PARTITION BY mes), 2) AS percentual_no_mes FROM base ORDER BY mes, grupo",
