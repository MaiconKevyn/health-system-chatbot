  "question_pt": "Qual o custo m\u00e9dio de UTI por especialidade m\u00e9dica e sexo do paciente, considerando apenas interna\u00e7\u00f5es com custo de UTI registrado?",
  "executed_at": "2026-07-09T00:36:46.454159+00:00",
  "database_file": "/Users/maiconkevyn/PycharmProjects/databases/datasus/sihrd5.duckdb",
  "sql": "SELECT e.\"DESCRICAO\" AS especialidade, CASE WHEN i.\"SEXO\" = 1 THEN 'Masculino' ELSE 'Feminino' END AS sexo, ROUND(AVG(i.\"VAL_UTI\"), 2) AS custo_medio_uti FROM internacoes i JOIN especialidade e ON i.\"ESPEC\" = e.\"ESPEC\" WHERE i.\"VAL_UTI\" > 0 AND i.\"SEXO\" IN (1, 3) GROUP BY e.\"DESCRICAO\", i.\"SEXO\" ORDER BY custo_medio_uti DESC",
