{
  "id": "GT231",
  "question_pt": "Qual percentual de internacoes possui diagnostico secundario preenchido por ano e por desfecho?",
  "executed_at": "2026-07-09T00:37:02.116112+00:00",
  "database_file": "/Users/maiconkevyn/PycharmProjects/databases/datasus/sihrd5.duckdb",
  "sql": "WITH agg AS (SELECT EXTRACT(YEAR FROM \"DT_INTER\") AS ano, CASE WHEN \"MORTE\" = true THEN 'obito' ELSE 'sem_obito' END AS desfecho, COUNT(*) AS total_internacoes, SUM(CASE WHEN \"DIAG_SECUN\" IS NOT NULL AND \"DIAG_SECUN\" <> '' THEN 1 ELSE 0 END) AS com_diag_secundario FROM internacoes WHERE \"DT_INTER\" IS NOT NULL GROUP BY ano, desfecho) SELECT ano, desfecho, total_internacoes, com_diag_secundario, ROUND(com_diag_secundario * 100.0 / NULLIF(total_internacoes, 0), 2) AS percentual_com_diag_secundario FROM agg ORDER BY ano, desfecho",
  "duration_seconds": 0.223128,
  "performance_class": "fast",
