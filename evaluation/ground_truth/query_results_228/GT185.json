  "sql": "SELECT i.\"CNES\", COALESCE(h.\"NO_HOSPITAL\", 'Sem nome cadastrado') AS hospital, COUNT(*) AS internacoes_uti FROM internacoes i LEFT JOIN hospital h ON i.\"CNES\" = h.\"CNES\" WHERE i.\"MARCA_UTI\" <> 0 AND i.\"CNES\" IS NOT NULL GROUP BY i.\"CNES\", h.\"NO_HOSPITAL\" ORDER BY internacoes_uti DESC LIMIT 10",
