  "sql": "SELECT r.\"DESCRICAO\" AS raca_cor, COUNT(*) AS total_internacoes, ROUND(COUNT(*) * 100.0 / SUM(COUNT(*)) OVER (), 2) AS percentual FROM internacoes i JOIN raca_cor r ON i.\"RACA_COR\" = r.\"RACA_COR\" WHERE i.\"RACA_COR\" IN (1, 2, 3, 4, 5) GROUP BY r.\"DESCRICAO\" ORDER BY total_internacoes DESC",
