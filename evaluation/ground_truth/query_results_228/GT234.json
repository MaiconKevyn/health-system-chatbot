  "question_pt": "Quais capitulos CID concentram mais internacoes de alto custo acima do percentil 99 do valor total?",
  "executed_at": "2026-07-09T00:37:03.925863+00:00",
  "database_file": "/Users/maiconkevyn/PycharmProjects/databases/datasus/sihrd5.duckdb",
  "sql": "WITH limite AS (SELECT QUANTILE_CONT(\"VAL_TOT\", 0.99) AS p99_valor FROM internacoes WHERE \"VAL_TOT\" IS NOT NULL), alto_custo AS (SELECT i.\"DIAG_PRINC\", i.\"VAL_TOT\" FROM internacoes i, limite l WHERE i.\"VAL_TOT\" > l.p99_valor) SELECT c.\"DS_CAPITULO\" AS capitulo_cid, COUNT(*) AS internacoes_alto_custo, ROUND(SUM(a.\"VAL_TOT\"), 2) AS custo_total_alto_custo FROM alto_custo a JOIN cid c ON a.\"DIAG_PRINC\" = c.\"CID\" GROUP BY c.\"DS_CAPITULO\" ORDER BY internacoes_alto_custo DESC LIMIT 10",
