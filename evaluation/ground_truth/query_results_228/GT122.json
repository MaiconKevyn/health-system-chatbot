  "sql": "SELECT proc_rea, nome_proc FROM (SELECT p.\"PROC_REA\" AS proc_rea, p.\"NOME_PROC\" AS nome_proc, COUNT(*) AS total_procedimentos, ROUND(SUM(COUNT(*)) OVER (ORDER BY COUNT(*) DESC ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) * 100.0 / SUM(COUNT(*)) OVER (), 2) AS pct_acumulado FROM internacoes i JOIN procedimentos p ON i.\"PROC_REA\" = p.\"PROC_REA\" GROUP BY p.\"PROC_REA\", p.\"NOME_PROC\") sub WHERE pct_acumulado <= 80 ORDER BY total_procedimentos DESC",
