  "sql": "SELECT c.\"DESCRICAO\" AS diagnostico, COUNT(*) AS total_obitos, ROUND(SUM(i.\"VAL_UTI\"), 2) AS custo_total_uti FROM internacoes i JOIN cid c ON i.\"DIAG_PRINC\" = c.\"CID\" WHERE i.\"MORTE\" = true AND i.\"VAL_UTI\" > 0 GROUP BY c.\"DESCRICAO\" HAVING COUNT(*) > 1000 ORDER BY custo_total_uti DESC LIMIT 10",
