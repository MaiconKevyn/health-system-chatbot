  "id": "GT211",
  "question_pt": "Qual percentual de internacoes de cada ano entre 2019 e 2023 foi por capitulo CID?",
  "executed_at": "2026-07-09T00:36:58.777444+00:00",
  "database_file": "/Users/maiconkevyn/PycharmProjects/databases/datasus/sihrd5.duckdb",
  "sql": "WITH agg AS (SELECT EXTRACT(YEAR FROM i.\"DT_INTER\") AS ano, c.\"DS_CAPITULO\" AS capitulo_cid, COUNT(*) AS total_internacoes FROM internacoes i JOIN cid c ON i.\"DIAG_PRINC\" = c.\"CID\" WHERE EXTRACT(YEAR FROM i.\"DT_INTER\") BETWEEN 2019 AND 2023 GROUP BY ano, c.\"DS_CAPITULO\") SELECT ano, capitulo_cid, total_internacoes, ROUND(total_internacoes * 100.0 / SUM(total_internacoes) OVER (PARTITION BY ano), 2) AS percentual_no_ano FROM agg ORDER BY ano, percentual_no_ano DESC",
  "duration_seconds": 0.218942,
  "performance_class": "fast",
  "row_count": 105,
