  "sql": "SELECT i.\"CNES\", COALESCE(h.\"NO_HOSPITAL\", 'Sem nome cadastrado') AS hospital, COUNT(*) AS total_mortes FROM internacoes i LEFT JOIN hospital h ON i.\"CNES\" = h.\"CNES\" WHERE i.\"MORTE\" = true AND i.\"CNES\" IS NOT NULL GROUP BY i.\"CNES\", h.\"NO_HOSPITAL\" ORDER BY total_mortes DESC LIMIT 10",
