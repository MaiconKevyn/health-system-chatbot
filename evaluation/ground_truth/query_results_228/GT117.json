  "sql": "SELECT EXTRACT(YEAR FROM \"DT_INTER\") AS ano, COUNT(CASE WHEN \"SEXO\" = 1 THEN 1 END) AS homens_uti, COUNT(CASE WHEN \"SEXO\" = 3 THEN 1 END) AS mulheres_uti, ROUND(COUNT(CASE WHEN \"SEXO\" = 1 THEN 1 END) * 100.0 / NULLIF(COUNT(CASE WHEN \"SEXO\" = 3 THEN 1 END), 0), 2) AS razao_h_m_pct FROM internacoes WHERE \"VAL_UTI\" > 0 AND \"ESPEC\" = 1 AND \"DT_INTER\" IS NOT NULL GROUP BY ano ORDER BY ano",
