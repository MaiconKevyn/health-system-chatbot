{
  "id": "GT203",
  "question_pt": "Como a taxa de mortalidade por doencas respiratorias compara inverno e fora do inverno por ano?",
  "executed_at": "2026-07-09T00:36:56.485640+00:00",
  "database_file": "/Users/maiconkevyn/PycharmProjects/databases/datasus/sihrd5.duckdb",
  "sql": "WITH base AS (SELECT EXTRACT(YEAR FROM \"DT_INTER\") AS ano, CASE WHEN EXTRACT(MONTH FROM \"DT_INTER\") IN (6, 7, 8) THEN 'inverno' ELSE 'fora_inverno' END AS periodo, \"MORTE\" FROM internacoes WHERE \"DIAG_PRINC\" LIKE 'J%' AND \"DT_INTER\" IS NOT NULL) SELECT ano, periodo, COUNT(*) AS total_internacoes, SUM(CASE WHEN \"MORTE\" = true THEN 1 ELSE 0 END) AS total_mortes, ROUND(SUM(CASE WHEN \"MORTE\" = true THEN 1 ELSE 0 END) * 100.0 / NULLIF(COUNT(*), 0), 2) AS taxa_mortalidade FROM base GROUP BY ano, periodo ORDER BY ano, periodo",
  "duration_seconds": 0.116804,
  "performance_class": "fast",
