  "question_pt": "Qual a media movel de 3 anos da taxa de mortalidade no RS?",
  "executed_at": "2026-07-09T00:36:59.593341+00:00",
  "database_file": "/Users/maiconkevyn/PycharmProjects/databases/datasus/sihrd5.duckdb",
  "sql": "WITH anual AS (SELECT EXTRACT(YEAR FROM i.\"DT_INTER\") AS ano, COUNT(*) AS total_internacoes, SUM(CASE WHEN i.\"MORTE\" = true THEN 1 ELSE 0 END) AS total_mortes FROM internacoes i LEFT JOIN municipios m ON i.\"MUNIC_RES\" = m.\"CO_MUNICIPIO_6D\" WHERE m.\"SG_UF\" = 'RS' AND EXTRACT(YEAR FROM i.\"DT_INTER\") BETWEEN 2008 AND 2023 GROUP BY ano), taxas AS (SELECT ano, total_internacoes, total_mortes, total_mortes * 100.0 / NULLIF(total_internacoes, 0) AS taxa_mortalidade FROM anual) SELECT ano, ROUND(AVG(taxa_mortalidade) OVER (ORDER BY ano ROWS BETWEEN 2 PRECEDING AND CURRENT ROW), 2) AS media_movel_3_anos_taxa_mortalidade FROM taxas ORDER BY ano",
