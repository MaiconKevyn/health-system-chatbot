{
  "id": "GT206",
  "question_pt": "Qual a razao anual entre uso de UTI em pacientes com 65 anos ou mais e pacientes com menos de 65 anos?",
  "executed_at": "2026-07-09T00:36:56.900171+00:00",
  "database_file": "/Users/maiconkevyn/PycharmProjects/databases/datasus/sihrd5.duckdb",
  "sql": "WITH agg AS (SELECT EXTRACT(YEAR FROM \"DT_INTER\") AS ano, CASE WHEN \"IDADE\" >= 65 THEN '65_mais' ELSE 'menor_65' END AS grupo_idade, COUNT(*) AS total_internacoes, SUM(CASE WHEN \"MARCA_UTI\" <> 0 THEN 1 ELSE 0 END) AS internacoes_uti FROM internacoes WHERE \"IDADE\" IS NOT NULL AND \"DT_INTER\" IS NOT NULL GROUP BY ano, grupo_idade), taxas AS (SELECT ano, grupo_idade, internacoes_uti * 1.0 / NULLIF(total_internacoes, 0) AS taxa_uti FROM agg) SELECT ano, ROUND(MAX(CASE WHEN grupo_idade = '65_mais' THEN taxa_uti END) / NULLIF(MAX(CASE WHEN grupo_idade = 'menor_65' THEN taxa_uti END), 0), 2) AS razao_uti_65_mais_vs_menor_65 FROM taxas GROUP BY ano ORDER BY ano",
